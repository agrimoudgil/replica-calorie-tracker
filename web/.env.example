# Copy this file to .env.local (git-ignored) and fill in the values.
# Never commit .env.local or paste these values into chat, docs or issues.

# --- Supabase (Project Settings → API Keys) --------------------------------
# Leave both empty to run on the local development store with no accounts.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...). SERVER ONLY. Bypasses row level security.
# Used for AI usage records, account deletion and the seed script.
SUPABASE_SECRET_KEY=

# Show "Continue with Google" once the Google provider is set up in Supabase: on | off
NEXT_PUBLIC_GOOGLE_SIGN_IN=off

# --- AI meal estimates --------------------------------------------------------
# Photo logging (photo → AI estimate): on | off. Off (the default) hides every photo
# screen and refuses estimates, so no AI is called and nothing is spent, even with a key.
PHOTO_LOGGING=off
# Without a key the app uses the free demo estimator (sample plates, clearly labelled).
ANTHROPIC_API_KEY=
# claude | demo (unset: claude when ANTHROPIC_API_KEY is set)
MEAL_ESTIMATOR=
MEAL_MODEL=claude-opus-5-5
# AI calls per person per day (photo estimates and meal reading together).
DAILY_ESTIMATE_LIMIT=15
# AI calls per day across everyone: the hard cap on spend (new accounts can't get round it).
AI_GLOBAL_DAILY_LIMIT=300

# --- AI reading of typed and spoken meals ---------------------------------------
# on | off. Off (the default): typing uses only the free word matcher. On: the AI reads
# just the parts the matcher can't find and names foods and portions; calories and
# macros always come from the food list. Needs ANTHROPIC_API_KEY (or runs the free demo reader).
AI_TEXT_LOGGING=off
# Model for reading meals (unset: MEAL_MODEL). Rough cost per AI read at October 2026 prices:
# claude-opus-5-5 $0.005–0.011, claude-sonnet-5-5 $0.003–0.006, claude-haiku-5-5 $0.0002–0.0003.
TEXT_MODEL=

# --- Voice logging -----------------------------------------------------------------
# on | off. The browser turns speech into text (free to run; Google or Apple hear the
# audio, as the privacy page then says). The text goes through the same matching as typing.
VOICE_LOGGING=off
